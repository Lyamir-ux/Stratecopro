# Copier en .env.local et renseigner (Supabase → Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Clé anon "legacy" (format JWT) : requise pour appeler les edge functions
# depuis les pages publiques (signature des cosignataires sans compte).
# Supabase → Settings → API keys → Legacy anon key. Clé publique par nature.
VITE_SUPABASE_FUNCTIONS_KEY=
